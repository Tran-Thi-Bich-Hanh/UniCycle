# Cấu hình kết nối Blockchain Avalanche Fuji Testnet (Giai đoạn 3)
# Xem hướng dẫn chi tiết từng bước tại: contracts/REMIX_DEPLOY_GUIDE.md

# Địa chỉ Smart Contract đồng UniCyclePoint (UNIP) sau khi Deploy trên Remix IDE
NEXT_PUBLIC_UNIP_CONTRACT_ADDRESS=

# Khóa bí mật (Private Key) của Ví Chủ (Master Wallet) dùng để đúc UNIP và trả phí gas hộ sinh viên
MASTER_WALLET_PRIVATE_KEY=

# RPC công khai của mạng Avalanche Fuji Testnet (Chain ID: 43113)
NEXT_PUBLIC_AVALANCHE_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc

