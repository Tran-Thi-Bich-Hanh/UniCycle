# ==============================================================================
# UNICYCLE - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# Sao chép file này thành file .env và điền các giá trị thực tế tương ứng:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU POSTGRESQL (SUPABASE HOẶC NEON)
# ------------------------------------------------------------------------------
# DATABASE_URL: Chuỗi kết nối Postgres qua pooler (Transaction mode, cổng 6543 nếu dùng Supabase)
# Dùng cho các truy vấn dữ liệu thông thường trong toàn bộ ứng dụng qua Prisma
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Chuỗi kết nối trực tiếp (Session mode, cổng 5432)
# Bắt buộc khi dùng Prisma để chạy db push / migrate
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE API & STORAGE (LƯU TRỮ ẢNH VÀ XÁC THỰC)
# ------------------------------------------------------------------------------
# URL của Project Supabase (tìm thấy trong Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co

# Anon Public Key (khóa công khai an toàn cho trình duyệt)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5c...

# Service Role Secret Key (khóa bí mật quản trị - dùng cho server-side backend và ký JWT token)
# LƯU Ý: Tuyệt đối KHÔNG chia sẻ hoặc commit key này lên git public!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5c...

# ------------------------------------------------------------------------------
# 3. DOMAIN & CẤU HÌNH ỨNG DỤNG
# ------------------------------------------------------------------------------
# URL gốc của ứng dụng (dùng cho các liên kết chia sẻ Zalo, QR code Passport)
# Localhost: http://localhost:3000
# Production: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. BLOCKCHAIN AVALANCHE FUJI TESTNET (GIAI ĐOẠN 3 - DIGITAL PRODUCT PASSPORT)
# ------------------------------------------------------------------------------
# Xem chi tiết cách deploy Smart Contract tại: contracts/REMIX_DEPLOY_GUIDE.md

# Địa chỉ hợp đồng Smart Contract UniCyclePoint (UNIP) sau khi Deploy trên Remix IDE
NEXT_PUBLIC_UNIP_CONTRACT_ADDRESS=

# Private Key của Master Wallet (Ví Chủ) trả gas đúc UNIP và chuyển giao Passport
# CẢNH BÁO: Chỉ dùng ví testnet, KHÔNG DÙNG ví chứa tiền thật Mainnet!
MASTER_WALLET_PRIVATE_KEY=

# RPC URL công khai của Avalanche Fuji Testnet (Chain ID: 43113)
NEXT_PUBLIC_AVALANCHE_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
